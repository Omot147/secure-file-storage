# Copy to .env — never commit the real file

# Postgres connection string. If using a local Postgres install:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/file_storage"
# If using a hosted free tier (Neon, Supabase Postgres, Railway):
# use the connection string they give you.
DATABASE_URL="postgresql://user:password@localhost:5432/file_storage"

PORT=5000
CLIENT_ORIGIN=http://localhost:5173

JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# From your Cloudinary dashboard (cloudinary.com/console) — Day 2
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
